# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=
PORT=
FRONTEND_URL=

# ─── Database (Neon PostgreSQL) ───────────────────────────────────────────────
DATABASE_URL=

# ─── Redis (BullMQ + Rate Limiting) ──────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Elasticsearch ────────────────────────────────────────────────────────────
ELASTICSEARCH_URL=http://localhost:9200

# ─── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# ─── Session ──────────────────────────────────────────────────────────────────
SESSION_SECRET=

# ─── Slack OAuth ──────────────────────────────────────────────────────────────
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=

# ─── Worker / Rate Limiting ───────────────────────────────────────────────────
WORKER_CONCURRENCY=
MIN_EMAIL_DELAY_MS=
MAX_EMAILS_PER_HOUR=

# ─── Ethereal SMTP (test email sending) ──────────────────────────────────────
ETHEREAL_HOST=
ETHEREAL_PORT=
ETHEREAL_USER=
ETHEREAL_PASSWORD=
