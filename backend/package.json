{
  "name": "mailflow-backend",
  "version": "1.0.0",
  "description": "MailFlow — production-oriented email scheduling platform backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "redis:up": "docker compose -f ../docker-compose.yml up -d redis",
    "redis:down": "docker compose -f ../docker-compose.yml down",
    "redis:logs": "docker compose -f ../docker-compose.yml logs -f redis",
    "redis:test": "tsx src/utils/test-redis-connection.ts",
    "queue:test": "tsx src/utils/test-email-queue.ts",
    "scheduler:test": "tsx src/utils/test-scheduler-service.ts",
    "worker": "tsx src/workers/index.ts",
    "worker:test": "tsx src/utils/test-worker-delivery.ts",
    "reliability:test": "tsx src/utils/test-reliability-idempotency.ts",
    "es:up": "docker compose -f ../docker-compose.yml up -d elasticsearch",
    "es:down": "docker compose -f ../docker-compose.yml down",
    "es:logs": "docker compose -f ../docker-compose.yml logs -f elasticsearch",
    "es:test": "tsx src/utils/test-elasticsearch-connection.ts",
    "services:up": "docker compose -f ../docker-compose.yml up -d",
    "postinstall": "prisma generate"
  },
  "keywords": [
    "mailflow",
    "email",
    "scheduling",
    "bullmq"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@elastic/elasticsearch": "^9.5.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@types/pg": "^8.23.1",
    "bullmq": "^6.3.8",
    "cors": "^2.8.6",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "morgan": "^1.12.1",
    "nodemailer": "^10.0.10",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.23.0",
    "prisma": "^7.10.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.2",
    "@types/nodemailer": "^8.0.2",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.17",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
